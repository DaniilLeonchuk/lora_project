def background_fetch():
    """Фоновая задача для регулярного получения последних данных каждые 5 минут"""
    global last_fetch_time
    
    while True:
        try:
            current_time = time.time()
            
            # Проверяем, прошло ли 5 минут с последнего получения
            if current_time - last_fetch_time >= DATA_FETCH_INTERVAL:
                print(f"\n{'='*50}")
                print(f"🔄 Получение последних данных ({datetime.now().strftime('%H:%M:%S')})")
                print(f"Количество устройств: {len(DEV_EUI_LIST)}")
                
                success, message = fetch_all_iot_data_sync(DEV_EUI_LIST)
                
                if success:
                    last_fetch_time = current_time
                    print(f"✅ {message}")
                    # Показываем время следующего получения
                    next_fetch = datetime.fromtimestamp(last_fetch_time + DATA_FETCH_INTERVAL)
                    print(f"⏰ Следующее получение: {next_fetch.strftime('%H:%M:%S')}")
                else:
                    print(f"❌ {message}")
                
                print(f"{'='*50}\n")
            else:
                # Рассчитываем оставшееся время до следующего получения
                remaining = DATA_FETCH_INTERVAL - (current_time - last_fetch_time)
                if remaining > 0:
                    minutes = int(remaining // 60)
                    seconds = int(remaining % 60)
                    if minutes > 0:
                        print(f"⏳ Следующее получение данных через {minutes} мин {seconds} сек", end='\r')
                    else:
                        print(f"⏳ Следующее получение данных через {seconds} сек    ", end='\r')
            
            # Ждем 1 секунду перед следующей проверкой
            time.sleep(1)
            
        except Exception as e:
            print(f"❌ Ошибка в фоновой задаче: {e}")
            time.sleep(10)
