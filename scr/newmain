    conn = get_db_connection()
    cur = conn.cursor()
    
    try:
        # Сначала обновляем device_eui в таблице devices если нужно
        if device_eui and device_id:
            cur.execute('''
                UPDATE devices 
                SET device_eui = ?
                WHERE device_id = ? AND (device_eui IS NULL OR device_eui != ?)
            ''', (device_eui, device_id, device_eui))
        
        if device_type == 'HS0101':
            cur.execute('''
                INSERT INTO measurements 
                (device_eui, device_id, device_type, temperature, humidity, door_open, door_open2, 
                 battery_level, corner, low_humidity, up_humidity, 
                 low_temperature, up_temperature, raw_data)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            ''', (device_eui, device_id, device_type, 
                  parsed_data['temperature'], parsed_data['humidity'],
                  parsed_data['door_open'], parsed_data['door_open2'],
                  parsed_data['battery'], parsed_data['corner'],
                  parsed_data['low_humidity'], parsed_data['up_humidity'],
                  parsed_data['low_temperature'], parsed_data['up_temperature'],
                  parsed_data['raw_data']))
        
        elif device_type == 'TL11':
            cur.execute('''
                INSERT INTO measurements 
                (device_eui, device_id, device_type, temperature, temperature2, battery_level, raw_data)
                VALUES (?, ?, ?, ?, ?, ?, ?)
            ''', (device_eui, device_id, device_type,
                  parsed_data['temperature'], parsed_data['temperature2'], 
                  parsed_data['battery'], parsed_data['raw_data']))
        
        conn.commit()
        print(f"✅ Данные сохранены: Device EUI: {device_eui}, ID: {device_id}, Type: {device_type}")
        
        check_thresholds_and_notify(device_id, parsed_data)
        
    except Exception as e:
        print(f"❌ Ошибка при сохранении данных: {e}")
        conn.rollback()
    finally:
        conn.close()

# Функция для обработки данных от устройства
def process_device_data(device_eui, hex_data):
    """Обрабатываем данные от устройства"""
    try:
        # Определяем тип устройства
        device_type = detect_device_type(hex_data)
        if not device_type:
            print(f"Не удалось определить тип устройства для EUI: {device_eui}")
            return
        
        # Парсим данные в зависимости от типа устройства
        if device_type == 'HS0101':
            parsed_data = parse_hs0101_data(hex_data)
            device_id = 'HS0101_001'  # Предполагаем, что это HS0101
        elif device_type == 'TL11':
            parsed_data = parse_tl11_data(hex_data)
            device_id = 'TL11_001'    # Предполагаем, что это TL11
        else:
            print(f"Неизвестный тип устройства: {device_type}")
            return
        
        if parsed_data:
            save_measurement(device_eui, device_id, device_type, parsed_data)
        else:
            print(f"Не удалось распарсить данные для EUI: {device_eui}")
            
    except Exception as e:
        print(f"Ошибка при обработке данных устройства {device_eui}: {e}")

# Асинхронное получение данных с IoT сервера
async def fetch_iot_data_async():
    """Асинхронная функция для получения данных с IoT сервера"""
    global iot_server_available
    
    try:
        print(f"Попытка подключения к серверу {SERVER_URL}...")
        
        async with websockets.connect(SERVER_URL, open_timeout=10, close_timeout=5) as websocket:
            iot_server_available = True
            print(f"✅ Подключено к серверу {SERVER_URL}")

            # 1. Авторизация
            auth_request = {
                "cmd": "auth_req",
                "login": LOGIN,
                "password": PASSWORD
            }
            await websocket.send(json.dumps(auth_request))
            auth_response = await websocket.recv()
            auth_data = json.loads(auth_response)

            if auth_data.get("status") is True and "token" in auth_data:
                token = auth_data["token"]
                print(f"Авторизация успешна. Получен токен: {token}")

                # 2. Запрашиваем данные для всех устройств
                for device_eui in DEVICE_EUIS:
                    print(f"Запрашиваем данные для устройства: {device_eui}")
                    
                    data_request = {
                        "cmd": "get_data_req",
                        "devEui": device_eui,
                        "direction": "UPLINK",
                        "select": {
                            "date_from": calendar.timegm(time.strptime('2025-04-12 15:00:00', '%Y-%m-%d %H:%M:%S'))
                        }
                    }
                    await websocket.send(json.dumps(data_request))
                    
                    try:
                        # Ждем ответа с таймаутом
                        response = await asyncio.wait_for(websocket.recv(), timeout=10)
                        data = json.loads(response)
                        
                        if data.get("cmd") == "get_data_resp":
                            print(f"✅ Получены данные для устройства {device_eui}")
                            
                            if "data_list" in data:
                                for item in data["data_list"]:
                                    if "data" in item:
                                        hex_data = item["data"]
                                        print(f"Обрабатываем данные: {hex_data}")
                                        process_device_data(device_eui, hex_data)
                            else:
                                print(f"Нет данных в ответе для устройства {device_eui}")
                                
                        elif data.get("status") is False:
                            print(f"❌ Ошибка для устройства {device_eui}: {data.get('err_string')}")
                            
                    except asyncio.TimeoutError:
                        print(f"Таймаут при ожидании ответа от устройства {device_eui}")
                        continue
                    except Exception as e:
                        print(f"Ошибка при обработке ответа от устройства {device_eui}: {e}")
                        continue

            else:
                print(f"Ошибка авторизации: {auth_data.get('err_string', 'Неизвестная ошибка')}")

    except Exception as e:
        iot_server_available = False
        print(f"❌ Ошибка при получении данных: {e}")

# Остальные функции остаются без изменений...
def fetch_iot_data_sync():
    """Синхронная обертка для асинхронной функции"""
    try:
        loop = asyncio.new_event_loop()
        asyncio.set_event_loop(loop)
        loop.run_until_complete(fetch_iot_data_async())
        loop.close()
        return True, "Данные успешно получены"
    except Exception as e:
        return False, f"Ошибка: {str(e)}"

# Фоновая задача для получения данных
def background_fetch():
    """Фоновая задача для регулярного получения данных"""
    while True:
        try:
            success, message = fetch_iot_data_sync()
            if success:
                print(f"✅ {message}")
            else:
                print(f"❌ {message}")
            time.sleep(60)
        except Exception as e:
            print(f"❌ Ошибка в фоновой задаче: {e}")
            time.sleep(10)

